# PostgreSQL connection string
DATABASE_URL=....

# LLM provider for prompt-injection analysis: "anthropic" or "gemini".
# If unset, the proxy picks whichever provider has a key configured below.
LLM_PROVIDER=gemini

# Anthropic API key (used when LLM_PROVIDER=anthropic).
# Get one at https://console.anthropic.com. Optional if you use Gemini.
ANTHROPIC_API_KEY=

# Gemini API key (used when LLM_PROVIDER=gemini).
# Free tier available at https://aistudio.google.com/apikey. Optional if you use Anthropic.
GEMINI_API_KEY=

# Override the Gemini model. Defaults to gemini-2.5-flash.
# Cheaper/faster alternative: gemini-2.5-flash-lite
# GEMINI_MODEL=gemini-2.5-flash

# Backend server
BACKEND_PORT=3000

# Proxy server
PROXY_PORT=8080

# Shared secret protecting POST /api/scans. Optional but strongly recommended:
# without it, anything that can reach localhost:3000 (a malicious page in a
# browser, a rogue process) can inject fake scans into the dashboard.
# Generate one with:  node -e "console.log(crypto.randomBytes(32).toString('hex'))"
INGEST_TOKEN=
